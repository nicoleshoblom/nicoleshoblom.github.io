---
const { PageTitle } = Astro.props
//refactor base layout by creating separate style file and components files
---

<html lang="en">
    <head>
        <script src="https://cdn.jsdelivr.net/npm/vega@5"></script>
        <script src="https://cdn.jsdelivr.net/npm/vega-lite@5"></script>
        <script src="https://cdn.jsdelivr.net/npm/vega-embed@6"></script>
        <meta charset="utf-8">
        <link rel="icon" type="image/png" href="/myfavicon.png" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
        <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="generator" content={Astro.generator} />
        <title>{PageTitle}</title>
        <style>
            @font-face {
                font-family: 'Lunar Blossom';
                src: url('/fonts/Lunar-Blossom.otf') format('opentype');
                font-weight: normal;
                font-style: normal;
            }
            body {
                font-family: 'Open Sans', sans-serif;
                margin: 0;
                padding-top: 70px;
                height:100vh;
                background-color: whitesmoke;
            }
            .header {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;           /* ensure full width */
                z-index: 3000;
                background-color: whitesmoke;

                display: flex;
                align-items: center;
                justify-content: space-between;
                color: black;
                padding: 20px 10px 10px 10px;
            }
            .nav-links {
                font-family: 'Poppins', sans-serif;
                font-size: 15px;
                color: black;
                text-decoration: none;
                display: flex;
                gap: 15px;
                align-items: center;
            }
            .nav-links a,
            .dropdown-toggle {
                text-decoration: none;
                color: black;
                padding: 4px 10px;
                border-radius: 6px;
                transition: all 0.2s ease;
            }
            .nav-links a:hover,
            .dropdown-toggle:hover {
                color: coral;
                background-color: rgba(255, 127, 80, 0.08);
            }
            .nav-links a.active,
            .dropdown-toggle.active {
                background-color: coral;
                color: white;
            }
            /* Desktop Dropdown Styles */
            .nav-dropdown {
                position: relative;
                display: inline-flex;
                align-items: center;
            }
            .dropdown-toggle {
                cursor: pointer;
                background: none;
                border: none;
                font-family: inherit;
                font-size: inherit;
                display: inline-flex;
                align-items: center;
            }
            .dropdown-menu {
                display: none;
                position: absolute;
                top: 100%;
                left: 50%;
                transform: translateX(-50%) translateY(10px);
                background-color: whitesmoke;
                min-width: 200px;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
                border-radius: 8px;
                padding: 8px 0;
                z-index: 3001;
                margin-top: 10px;
                border: 1px solid rgba(0, 0, 0, 0.06);
                opacity: 0;
                transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                pointer-events: none;
            }
            .dropdown-menu::before {
                content: '';
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 15px;
                background: transparent;
            }
            .nav-dropdown:hover .dropdown-menu,
            .nav-dropdown:focus-within .dropdown-menu {
                display: flex;
                flex-direction: column;
                transform: translateX(-50%) translateY(0);
                opacity: 1;
                pointer-events: auto;
            }
            .dropdown-menu a {
                display: block;
                padding: 8px 16px;
                font-family: 'Poppins', sans-serif;
                font-size: 14px;
                color: black;
                text-decoration: none;
                transition: all 0.2s ease;
                text-align: center;
                border-radius: 4px;
                margin: 2px 8px;
            }
            .dropdown-menu a:hover {
                color: coral;
                background-color: rgba(255, 127, 80, 0.08);
            }
            .dropdown-menu a.active {
                background-color: coral;
                color: white;
            }
            .dropdown-arrow {
                font-size: 10px;
                margin-left: 5px;
                transition: transform 0.2s ease;
                vertical-align: middle;
            }
            .nav-dropdown:hover .dropdown-arrow,
            .nav-dropdown:focus-within .dropdown-arrow {
                transform: rotate(180deg);
                color: coral;
            }
            .title {
                position: absolute;
				left: 50%;
				transform: translateX(-50%);
                font-family: "Lunar Blossom", sans-serif;
                font-size: clamp(1.5rem, 7vw, 35px); /* Responsive font size */
                word-spacing: 5px;
                color: black;
                font-weight: normal;
                letter-spacing: 0.05em;
                margin-right: -0.05em;
            }
            .kern-ic {
                letter-spacing: -0.02em;
            }
            .hamburger {
                display: none;
                font-size: 25px;
                cursor: pointer;
                position: relative;

            }
            .icons {
                display: flex;
                gap: 10px;
            }
            /* .icon {
                font-size: 25px;
                cursor: pointer;
                color: black;
                text-decoration: none;
            }
            .icon:hover {
                color: coral;
            } */
            .material-icons {
                font-size: 25px;
                vertical-align: middle;
                color: black; /* Ensure the icon is black */
            }
			.material-icons:hover {
                color: coral;
            }
            .fa-linkedin {
                font-size: 25px;
                vertical-align: middle;
                color: black; /* Ensure the icon is black */
            }
			.fa-linkedin:hover {
                color: coral; /* Change color to coral on hover */
            }
            .fa-github {
                font-size: 25px;
                vertical-align: middle;
                color: black; /* Ensure the icon is black */
            }
			.fa-github:hover {
                color: coral; /* Change color to coral on hover */
            }
            .dropdown {
                display: none;
                flex-direction: column;
                gap: 10px;
                position: absolute;
                top: 100%;
				left: 0;
                background-color: white;
                border: 1px solid #ccc;
                padding: 10px;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
				font: 17px 'Poppins', sans-serif;
				text-align: center;
            }
            .dropdown a {
                color: black;
                text-decoration: none;
                padding: 6px 12px;
                border-radius: 6px;
                display: block;
                transition: all 0.2s ease;
            }
            .dropdown a:hover {
                color: coral;
                background-color: rgba(255, 127, 80, 0.08);
            }
			.dropdown a.active {
                background-color: coral;
                color: white;
            }
            .icon-arrow {
                display: none;
            }
            @media (max-width: 768px){
                .header{
                    padding-bottom: 10px;
                }
                .nav-links {
                    display: none;
                }
                .hamburger {
                    display: block;
                }
                /* Mobile Dropdown Nested Details Menu */
                .mobile-nav-details {
                    width: 100%;
                }
                .mobile-nav-summary {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 6px;
                    cursor: pointer;
                    color: black;
                    font-family: 'Poppins', sans-serif;
                    font-size: 17px;
                    list-style: none; /* Hide default arrow */
                    user-select: none;
                    width: 100%;
                    padding: 5px 0;
                }
                .mobile-nav-summary::-webkit-details-marker {
                    display: none; /* Hide default Safari arrow */
                }
                .mobile-nav-summary:hover,
                .mobile-nav-summary:focus {
                    color: coral;
                    outline: none;
                }
                .mobile-nav-summary.active {
                    color: coral;
                    font-weight: 600;
                }
                .summary-arrow {
                    font-size: 12px;
                    transition: transform 0.2s ease;
                }
                .mobile-nav-details[open] .summary-arrow {
                    transform: rotate(180deg);
                }
                .mobile-nav-sublinks {
                    display: flex;
                    flex-direction: column;
                    gap: 8px;
                    padding: 8px 0;
                    width: 100%;
                    background-color: rgba(0, 0, 0, 0.03);
                    border-radius: 6px;
                    margin-top: 4px;
                }
                .mobile-nav-sublinks a {
                    font-size: 15px;
                    padding: 6px 0;
                    color: #555;
                    display: block;
                    width: 100%;
                    text-decoration: none;
                }
                .mobile-nav-sublinks a:hover {
                    color: coral;
                }
                .mobile-nav-sublinks a.active {
                    background-color: coral;
                    color: white;
                    border-radius: 4px;
                }
            
            .material-icons a{
                touch-action: manipulation;
            }
            .material-icons:focus,
            .material-icons:hover {
                color: black;
                outline: none
            }
            .fa-linkedin a{
                touch-action: manipulation;
            }
            .fa-linkedin:focus,
            .fa-linkedin:hover {
                color: black;
                outline: none
            }
            .fa-github a{
                touch-action: manipulation;
            }
            .fa-github:focus,
            .fa-github:hover {
                color: black;
                outline: none
            }
            .icon-carousel {
                display: flex;
                align-items: center;
                gap: 0px;
            }

            .icons {
                display: flex;
                overflow-x: hidden;
                scroll-snap-type: x mandatory;
                width: 44px; /* exactly one icon wide */
                gap: 0px;
                padding: 0px;
            }

            .icon {
                flex: 0 0 100%;
                scroll-snap-align: center;
                display: flex;
                justify-content: center;
                align-items: center;
                text-decoration: none;
                color: inherit;
            }

            .icon-arrow {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: none;
                border: none;
                font-size: 20px;
                cursor: pointer;
                padding: 0px;
                padding-bottom: 3px;
                color: black;
                line-height: 1;
            }

            .icon-arrow:active {
                color: coral;
            }

            .icon-arrow:focus {
                outline: none;
            }
            }
            @media (max-width: 300px) {
                .title {
                    font-size: 1.2rem; /* Even smaller on very narrow screens */
                }
                .hamburger {
                    font-size: 1.2rem;
                }
                .material-icons,
                .fa-linkedin,
                .fa-github {
                    font-size: 1.2rem;
                }
            }
        </style>
    </head>
    <body>
        <header class="header">
            <div class="nav-links">
                <a href="/" class="nav-link">Home</a>
                <div class="nav-dropdown">
                    <a href="/resume/" class="nav-link dropdown-toggle">
                        Resume <i class="fas fa-chevron-down dropdown-arrow"></i>
                    </a>
                    <div class="dropdown-menu">
                        <a href="/NicoleShoblom_OnePager.pdf" target="_blank" class="nav-link">Technical One Page</a>
                        <a href="/resume/" class="nav-link">Full Resume</a>
                    </div>
                </div>
                <a href="/blog/" class="nav-link">Blog</a>
            </div>
			<div class="hamburger" onclick="toggleDropdown()">&#9776;</div>
            <div class="title">N<span class="kern-ic">i</span>cole Shoblom</div>
            <div class="icon-carousel">
                <button class="icon-arrow left" aria-label="Previous icon">
                    ‹
                </button>

                <div class="icons">
                    <a href="mailto:nicole.shoblom@gmail.com" class="icon">
                    <span class="material-icons">email</span>
                    </a>
                    <a href="https://www.linkedin.com/in/navmendoza/" class="icon" target="_blank" rel="noopener noreferrer">
                    <i class="fab fa-linkedin"></i>
                    </a>
                    <a href="https://github.com/nicoleshoblom" class="icon" target="_blank" rel="noopener noreferrer">
                    <i class="fab fa-github"></i>
                    </a>
                </div>

                <button class="icon-arrow right" aria-label="Next icon">
                    ›
                </button>
            </div>
            <div class="dropdown" id="dropdown">
                <a href="/" class="nav-link">Home</a>
                <details class="mobile-nav-details">
                    <summary class="mobile-nav-summary">
                        Resume <i class="fas fa-chevron-down summary-arrow"></i>
                    </summary>
                    <div class="mobile-nav-sublinks">
                        <a href="/NicoleShoblom_OnePager.pdf" target="_blank" class="nav-link">Technical One Page</a>
                        <a href="/resume/" class="nav-link">Full Resume</a>
                    </div>
                </details>
                <a href="/blog/" class="nav-link">Blog</a>
            </div>
        </header>
        <slot />
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                function toggleDropdown() {
                    var dropdown = document.getElementById("dropdown");
                    if (dropdown.style.display === "flex") {
                        dropdown.style.display = "none";
                    } else {
                        dropdown.style.display = "flex";
                    }
                }
                document.querySelector('.hamburger').addEventListener('click', toggleDropdown);

                function pathsMatch(pathA, pathB) {
                    if (!pathA || !pathB) return false;
                    var cleanA = pathA.replace(/\/$/, "");
                    var cleanB = pathB.replace(/\/$/, "");
                    return cleanA === cleanB;
                }

				// Highlight the current page link
                var currentPath = window.location.pathname;
                var navLinks = document.querySelectorAll('.nav-link');
                navLinks.forEach(function(link) {
                    if (pathsMatch(link.getAttribute('href'), currentPath)) {
                        link.classList.add('active');

                        // Handle mobile dropdown details expansion
                        var detailsParent = link.closest('.mobile-nav-details');
                        if (detailsParent) {
                            detailsParent.setAttribute('open', '');
                            var summary = detailsParent.querySelector('.mobile-nav-summary');
                            if (summary) {
                                summary.classList.add('active');
                            }
                        }

                        // Handle desktop dropdown parent activation
                        var dropdownParent = link.closest('.nav-dropdown');
                        if (dropdownParent) {
                            var toggle = dropdownParent.querySelector('.dropdown-toggle');
                            if (toggle) {
                                toggle.classList.add('active');
                            }
                        }
                    }
                });

                // Close dropdown if clicked outside
                document.addEventListener('click', function(event) {
                    var dropdown = document.getElementById("dropdown");
                    var hamburger = document.querySelector('.hamburger');
                    if (dropdown && hamburger && !dropdown.contains(event.target) && !hamburger.contains(event.target)) {
                        dropdown.style.display = 'none';
                    }
                });

                // Remove focus state after click
                var icons = document.querySelectorAll('.material-icons');
                icons.forEach(function(icon) {
                    icon.addEventListener('click', function() {
                        icon.blur();
                    });
                });

                // Remove focus state after click
                var linkedin_icons = document.querySelectorAll('.fa-linkedin');
                linkedin_icons.forEach(function(icon) {
                    icon.addEventListener('click', function() {
                        icon.blur();
                    });
                });

                // Remove focus state after click
                var github_icons = document.querySelectorAll('.fa-github');
                github_icons.forEach(function(icon) {
                    icon.addEventListener('click', function() {
                        icon.blur();
                    });
                });

                const iconsContainer = document.querySelector('.icons');
                const leftArrow = document.querySelector('.icon-arrow.left');
                const rightArrow = document.querySelector('.icon-arrow.right');

                if (iconsContainer && leftArrow && rightArrow) {
                const iconWidth = iconsContainer.offsetWidth;

                leftArrow.addEventListener('click', () => {
                    iconsContainer.scrollBy({
                    left: -iconWidth,
                    behavior: 'smooth'
                    });
                });

                rightArrow.addEventListener('click', () => {
                    iconsContainer.scrollBy({
                    left: iconWidth,
                    behavior: 'smooth'
                    });
                });
                }

            });
        </script>
    </body>
</html>
