---
// A clickable card: cover image above a title, linking to a detail page.
// Reusable on any page — lay several out with <div class="section-cards">.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    title: string;
    href: string;
    image: ImageMetadata;
    alt?: string;
}

const { title, href, image, alt = title } = Astro.props;
---

<a href={href} class="section-card">
    <div class="section-card-image-wrap">
        <Image src={image} alt={alt} width={800} format="jpg" class="section-card-image" />
    </div>
    <h2 class="section-card-title">{title}</h2>
</a>

<style>
    .section-card {
        display: block;
        color: inherit;
        text-decoration: none;
        border-radius: 10px;
        transition: transform 0.2s ease;
    }
    .section-card:hover,
    .section-card:focus-visible {
        transform: translateY(-3px);
    }
    .section-card-image-wrap {
        overflow: hidden;
        border-radius: 8px;
        aspect-ratio: 4 / 3;
        background-color: #e8e8e8;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }
    .section-card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.25s ease;
    }
    .section-card:hover .section-card-image {
        transform: scale(1.03);
    }
    .section-card-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 1.2rem;
        text-align: center;
        margin: 12px 0 0 0;
    }
    .section-card:hover .section-card-title {
        text-decoration: underline;
    }
    /* Mobile: full-bleed images (the page container drops its side padding) */
    @media (max-width: 600px) {
        .section-card,
        .section-card-image-wrap {
            border-radius: 0;
        }
        .section-card-image-wrap {
            box-shadow: none;
        }
        .section-card:hover,
        .section-card:focus-visible {
            transform: none;
        }
        .section-card-title {
            padding: 0 16px;
        }
    }
</style>
