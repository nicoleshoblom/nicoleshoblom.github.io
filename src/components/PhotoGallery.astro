---
// Responsive photo grid; each photo opens full size in a new tab.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    images: ImageMetadata[];
    altPrefix: string;
}

const { images, altPrefix } = Astro.props;
---

<div class="gallery-grid">
    {images.map((image, index) => (
        <a href={image.src} target="_blank" rel="noopener noreferrer" class="gallery-item">
            <Image src={image} alt={`${altPrefix} - photo ${index + 1}`} width={800} format="jpg" class="gallery-image" />
        </a>
    ))}
</div>

<style>
    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
        gap: 12px;
    }
    .gallery-item {
        display: block;
        overflow: hidden;
        border-radius: 8px;
        aspect-ratio: 4 / 3;
        background-color: #e8e8e8;
    }
    .gallery-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.25s ease;
    }
    .gallery-item:hover .gallery-image {
        transform: scale(1.03);
    }
</style>
