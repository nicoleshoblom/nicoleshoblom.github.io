---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionCard from '../components/SectionCard.astro';
import recitalThumbnail from '../assets/ezra/y1-t1-recital/thumbnail.jpg';
import starOfWeekCover from '../assets/ezra/y1-t1-star-of-week/pic01.jpg';
const PageTitle = "Ezra";
---

<BaseLayout PageTitle={PageTitle} noindex>
    <h1 class="page-title">Ezra</h1>
    <div class="section-cards">
        <SectionCard
            title="Y1 T1 Private Music Lesson Recital"
            href="/ezra/y1-t1-recital/"
            image={recitalThumbnail}
            alt="Ezra playing ukulele at his Y1 T1 music recital"
        />
        <SectionCard
            title="Y1 T1 Star of the Week"
            href="/ezra/y1-t1-star-of-week/"
            image={starOfWeekCover}
            alt="Ezra's Y1 T1 Star of the Week"
        />
    </div>
</BaseLayout>
<style>
    .page-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 2rem;
        text-align: center;
        margin: 0;
        padding: 24px 16px 8px 16px;
        /* Stays just below the fixed site header while scrolling */
        position: sticky;
        top: 60px;
        z-index: 10;
        background-color: whitesmoke;
    }
    .section-cards {
        max-width: 1200px;
        margin: 0 auto;
        padding: 16px 16px 40px 16px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 400px));
        justify-content: center;
        gap: 28px;
    }
    /* Mobile: no side padding so the card images run edge to edge */
    @media (max-width: 600px) {
        .section-cards {
            padding-left: 0;
            padding-right: 0;
            grid-template-columns: 100%;
        }
    }
</style>
