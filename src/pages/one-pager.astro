                </div>
                <div class="contact-item">
                    <span class="material-icons">phone</span>
                    <span>+82 10-9379-2491</span>
                </div>
                <div class="contact-item">
                    <span class="material-icons">email</span>
                    <a href="mailto:nicole.shoblom@gmail.com">nicole.shoblom@gmail.com</a>
                </div>
                <div class="contact-item">
