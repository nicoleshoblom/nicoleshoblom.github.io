---
// Standalone One Pager Resume
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nicole Shoblom - Resume</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        @font-face {
            font-family: 'Lunar Blossom';
            src: url('/fonts/Lunar-Blossom.otf') format('opentype');
            font-weight: normal;
            font-style: normal;
        }

        :root {
            --coral: #ff7f50; /* Same as the website */
            --text-main: #000;
            --bg-main: #fff;
            --sidebar-bg: #fff;
        }

        /* A4 Size configuration */
        @page {
            size: A4;
            margin: 0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            color: var(--text-main);
            background-color: #e0e0e0; /* Grey background outside the page in web view */
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .resume-container {
            width: 595pt;
            height: 841pt;
            background: white;
            display: flex;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            overflow: hidden;
            position: relative;
        }

        /* Sidebar Styling */
        .sidebar {
            width: 25%;
            background-color: var(--sidebar-bg);
            border-right: 2px dotted var(--coral);
            padding: 10pt 10pt;
            display: flex;
            flex-direction: column;
            gap: 8pt;
        }

        .profile-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 6pt;
        }

        .profile-pic {
            width: 110pt;
            height: 110pt;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--coral);
        }

        .name {
            font-family: 'Lunar Blossom', sans-serif;
            font-size: 24pt;
            font-weight: normal;
            letter-spacing: 0.05em;
            margin-right: -0.05em; /* Offset trailing letter-spacing for pixel-perfect horizontal centering */
            line-height: 1.1;
        }

        .kern-ic {
            letter-spacing: -0.02em;
        }

        .title {
            font-family: 'Poppins', sans-serif;
            font-size: 9pt;
            font-weight: 600;
            color: var(--coral);
            line-height: 1.2;
        }

        .contact-info {
            font-size: 7.5pt;
            display: flex;
            flex-direction: column;
            gap: 3pt;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 5pt;
            word-break: break-word;
        }

        .contact-item i, .contact-item .material-icons {
            font-size: 10pt;
            color: var(--coral);
            width: 12pt;
            text-align: center;
        }

        .contact-item a {
            color: var(--text-main);
            text-decoration: none;
        }

        .section-header-sidebar {
            font-family: 'Poppins', sans-serif;
            font-size: 11pt;
            font-weight: 600;
            border-bottom: 1px solid var(--coral);
            padding-bottom: 2pt;
            margin-bottom: 4pt;
            text-transform: uppercase;
        }

        .list-section {
            font-size: 7.5pt;
            line-height: 1.3;
        }

        .list-section ul {
            padding-left: 12pt;
        }

        .list-section li {
            margin-bottom: 2pt;
        }

        .domains {
            display: flex;
            flex-wrap: wrap;
            gap: 3pt;
        }
        
        .domain-badge {
            background-color: var(--coral);
            color: white;
            padding: 2pt 4pt;
            border-radius: 3pt;
            font-size: 7pt;
            font-family: 'Poppins', sans-serif;
        }

        /* Main Body Styling */
        .main-body {
            width: 75%;
            padding: 15pt 15pt 10pt 15pt;
            display: flex;
            flex-direction: column;
            gap: 4pt;
        }

        .one-liner {
            font-family: 'Poppins', sans-serif;
            font-size: 11pt;
            font-weight: 700;
            color: var(--coral);
            line-height: 1.3;
        }

        .summary {
            font-size: 7.5pt;
            line-height: 1.35;
            text-align: justify;
            margin-bottom: 6pt;
        }

        .section-header-main {
            font-family: 'Poppins', sans-serif;
            font-size: 10pt;
            font-weight: 600;
            color: var(--coral);
            border-bottom: 2px solid var(--coral);
            padding-bottom: 1pt;
            margin-bottom: 3pt;
            text-transform: uppercase;
        }

        .experience-item, .education-item {
            margin-bottom: 5pt;
        }

        .exp-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 1pt;
        }

        .company-name {
            font-family: 'Poppins', sans-serif;
            font-size: 9pt;
            font-weight: 600;
        }

        .exp-dates {
            font-size: 7.5pt;
            font-style: italic;
            color: #555;
            text-align: right;
            white-space: nowrap;
        }

        .job-title {
            font-size: 8pt;
            font-weight: 600;
            margin-bottom: 2pt;
        }

        .exp-bullets {
            font-size: 7.5pt;
            line-height: 1.3;
            padding-left: 10pt;
        }

        .exp-bullets li {
            margin-bottom: 2pt;
            text-align: justify;
        }

        /* Mobile Screen Adjustments (scale A4 page to fit screen) */
        @media screen and (max-width: 800px) {
            body {
                background-color: #e0e0e0;
                display: block;
                min-height: auto;
                padding: 10px 0;
                overflow-x: hidden;
            }

            .resume-container {
                /* Scale the 595pt (~793.33px) container to fit the viewport width exactly (minus 20px padding) */
                transform: scale(calc((100vw - 20px) / 793.33));
                transform-origin: top center;
                margin: 0 auto;
                /* Pull up the bottom to remove the large blank whitespace created by scaling */
                margin-bottom: calc(-841pt * (1 - ((100vw - 20px) / 793.33)));
            }
        }

        /* Print Specific Adjustments */
        @media print {
            body {
                background: white;
                height: 100%;
                width: 100%;
                margin: 0;
            }
            .resume-container {
                box-shadow: none;
                width: 595pt;
                height: 841pt;
            }
            /* To ensure background colors and borders print correctly */
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }
    </style>
</head>
<body>
    <div class="resume-container">
        <!-- Sidebar -->
